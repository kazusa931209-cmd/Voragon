# Copy to .env and adjust for local development:
#   cp .env.example .env
#
# Environment variables override values in .env when both are set.

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# WebSocket session
RECONNECT_WINDOW_S=30
# Close connection when no inbound WS message for this many seconds (P2-001)
HEARTBEAT_IDLE_TIMEOUT_S=45
AUDIO_BUFFER_SECONDS=30

# VAD (silero | mock)
VAD_BACKEND=silero
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=250
VAD_MIN_SILENCE_DURATION_MS=500
VAD_SPEECH_PAD_MS=300

# ASR (faster_whisper | mock)
ASR_BACKEND=faster_whisper
# faster-whisper model id, e.g. tiny, base, small, large-v3-turbo
ASR_MODEL=large-v3-turbo
ASR_PARTIAL_INTERVAL_MS=300
